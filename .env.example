# ─── Nonfiction AI Studio — required environment variables ───────────────────
#
# Copy this file to .env and fill in real values for local development.
# In Replit, set these as Secrets (never paste real keys here).
#
# IMPORTANT: .env is git-ignored. .env.example must never contain real values.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Provisioned automatically on Replit.
DATABASE_URL=

# ─── AI Providers (at least ONE required for generation to work) ──────────────
# Multi-model specialized pipeline — each phase uses the best model for that task:
#   Idea/Titles:  Gemini Flash → Groq → OpenRouter → SambaNova
#   Research:     DeepSeek R1 → Gemini Pro → Groq → OpenRouter → SambaNova
#   Outline:      Gemini Pro → DeepSeek R1 → Groq → OpenRouter → SambaNova
#   Write:        Gemini Pro → OpenRouter (DeepSeek/Qwen/Maverick) → SambaNova → Groq
#   Edit:         Llama 4 Maverick → Gemini Pro → Groq → OpenRouter → SambaNova
#   Metadata:     Gemini Flash-Lite → Groq → OpenRouter → SambaNova
#
# Default fallback chain: Gemini → Groq → OpenRouter → SambaNova

# Gemini 2.5 Flash / Pro / Flash-Lite via Google AI Studio — primary AI (#1)
GEMINI_API_KEY=
# Groq (Llama 3.3 70B) — fast LPU inference fallback (#2)
GROQ_API_KEY=
# OpenRouter — DeepSeek R1, Qwen 3 32B, Llama 4 Maverick pool (#4)
OPENROUTER_API_KEY=
# SambaNova Cloud (Llama 3.3 70B) — last-resort fallback (#5)
SAMBANOVA_API_KEY=

# ─── Amazon Research Providers (at least ONE recommended) ────────────────────
# Rainforest API — primary Amazon data provider
RAINFOREST_API_KEY=
# Scale SERP — fallback Amazon data provider
SCALE_SERP_API_KEY=
