# ─── Nonfiction AI Studio — required environment variables ───────────────────
#
# Copy this file to .env and fill in real values for local development.
# In Replit, set these as Secrets (never paste real keys here).
#
# IMPORTANT: .env is git-ignored. .env.example must never contain real values.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Provisioned automatically on Replit.
DATABASE_URL=

# ─── AI Providers (at least ONE required for generation to work) ──────────────
# Gemini 2.5 Flash via Google AI Studio — primary provider
GEMINI_API_KEY=
# Groq (Llama 3.3 70B) — second in chain
GROQ_API_KEY=
# xAI / Grok — third in chain (optional, skip if unavailable)
XAI_API_KEY=
# OpenRouter (Llama 3.3 70B free) — last-resort fallback
OPENROUTER_API_KEY=

# ─── Amazon Research Providers (at least ONE recommended) ────────────────────
# Rainforest API — primary Amazon data provider
RAINFOREST_API_KEY=
# Scale SERP — fallback Amazon data provider
SCALE_SERP_API_KEY=
