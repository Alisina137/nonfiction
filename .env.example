# ─── Nonfiction AI Studio — required environment variables ───────────────────
#
# Copy this file to .env and fill in real values for local development.
# In Replit, set these as Secrets (never paste real keys here).
#
# IMPORTANT: .env is git-ignored. .env.example must never contain real values.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Provisioned automatically on Replit.
DATABASE_URL=

# ─── AI Providers (at least ONE required for generation to work) ──────────────
# Chain order: Gemini → Groq → Cerebras → OpenRouter → SambaNova
#
# Gemini 2.5 Flash via Google AI Studio — primary provider (#1)
GEMINI_API_KEY=
# Groq (Llama 3.3 70B) — fallback #2
GROQ_API_KEY=
# Cerebras Inference (Llama 3.3 70B) — fallback #3
CEREBRAS_API_KEY=
# OpenRouter (Llama 3.3 70B free) — fallback #4
OPENROUTER_API_KEY=
# SambaNova Cloud (Llama 3.3 70B) — fallback #5 / last resort
SAMBANOVA_API_KEY=

# ─── Amazon Research Providers (at least ONE recommended) ────────────────────
# Rainforest API — primary Amazon data provider
RAINFOREST_API_KEY=
# Scale SERP — fallback Amazon data provider
SCALE_SERP_API_KEY=
