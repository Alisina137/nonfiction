# ─── Nonfiction AI Studio — required environment variables ───────────────────
#
# Copy this file to .env and fill in real values for local development.
# In Replit, set these as Secrets (never paste real keys here).
#
# IMPORTANT: .env is git-ignored. .env.example must never contain real values.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Provisioned automatically on Replit.
DATABASE_URL=

# ─── AI Providers (at least ONE required for generation to work) ──────────────
# Multi-model specialized pipeline — each phase uses the best model for that task:
#   Idea/Titles:  Grok 4 → Gemini Flash → Groq → Cerebras → OpenRouter → SambaNova
#   Research:     DeepSeek R1 → Gemini Pro → Grok 4 → ...
#   Outline:      Gemini Pro → DeepSeek R1 → Grok 4 → ...
#   Write:        Gemini Pro → Grok 4 → OpenRouter (DeepSeek/Qwen/Maverick) → ...
#   Edit:         Llama 4 Maverick → Gemini Pro → Grok 4 → ...
#   Metadata:     Gemini Flash-Lite → Gemini Flash → Groq → ...
#
# Default fallback chain: Gemini → Grok → Groq → Cerebras → OpenRouter → SambaNova

# Gemini 2.5 Flash / Pro / Flash-Lite via Google AI Studio — primary AI (#1)
GEMINI_API_KEY=
# Grok 4 via xAI — creative ideation + idea generation (#2)
GROK_API_KEY=
# Groq (Llama 3.3 70B) — fast LPU inference fallback (#3)
GROQ_API_KEY=
# Cerebras Inference (Llama 3.3 70B) — low-latency fallback (#4)
CEREBRAS_API_KEY=
# OpenRouter — DeepSeek R1, Qwen 3 32B, Llama 4 Maverick pool (#5)
OPENROUTER_API_KEY=
# SambaNova Cloud (Llama 3.3 70B) — last-resort fallback (#6)
SAMBANOVA_API_KEY=

# ─── Amazon Research Providers (at least ONE recommended) ────────────────────
# Rainforest API — primary Amazon data provider
RAINFOREST_API_KEY=
# Scale SERP — fallback Amazon data provider
SCALE_SERP_API_KEY=
