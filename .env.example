# Nonfiction AI Studio — local development
# Copy this file to .env and add only the services you want to use.
# The app can start without any of these values.

# Local API port. The frontend proxies /api to http://localhost:8080.
PORT=8080

# Optional browser dev-server port. Defaults to 5173 and automatically falls back if occupied.
FRONTEND_PORT=5173

# AI providers — set at least one to enable AI generation.
# OPENROUTER_API_KEY is also used for PDF reference analysis.
GROQ_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=

# Optional live Amazon competitor data.
# Without these, the app falls back to Open Library metadata.
RAINFOREST_API_KEY=
SCALE_SERP_API_KEY=

# Optional database. The current personal workflow stores project state locally.
DATABASE_URL=
